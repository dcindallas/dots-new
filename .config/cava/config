## CAVA Config: Smokula Edition by Duane Cummins

[general]
bars = 0                ; Auto-adjust bar count to terminal width
bar_width = 1           ; Width of each bar in characters
bar_spacing = 1         ; Space between bars
; framerate = 60        ; Optional: uncomment to force refresh rate
; sensitivity = 100     ; Initial sensitivity

[input]
#method = pulse
#source = auto

[output]
#method = ncurses
#orientation = bottom
#channels = stereo
#reverse = 0
#bar_delimiter = 0
#xaxis = none

[color]
# Start flavours
[color]

gradient = 1
gradient_count = 4
gradient_color_1 = "#e2655e"
gradient_color_2 = "#d97e4a"
gradient_color_3 = "#fcbf49"
gradient_color_4 = "#e9d985"
# End flavours


[smoothing]
; noise_reduction = 0

[eq]
; Example EQ (uncomment to tweak frequency band response)
; 1 = 1
; 2 = 1
; 3 = 1
; 4 = 1
; 5 = 1
